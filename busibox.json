{
  "$schema": "https://busibox.io/schemas/app-manifest-v1.json",
  "name": "Newsletter Digest",
  "id": "newsletter-digest",
  "version": "1.0.0",
  "description": "AI-powered newsletter summaries for Microsoft 365 mailboxes.",
  "icon": "Newspaper",
  "defaultPath": "/newsletter-digest",
  "defaultPort": 3002,
  "healthEndpoint": "/api/health",
  "buildCommand": "npm run build",
  "startCommand": "npm start",
  "appMode": "frontend",
  "requiredEnvVars": [],
  "optionalEnvVars": [
    "MS_CLIENT_ID",
    "MS_CLIENT_SECRET",
    "MS_REDIRECT_URI",
    "MS_TENANT_ID",
    "MS_SHARED_MAILBOX",
    "LINKEDIN_CLIENT_ID",
    "LINKEDIN_CLIENT_SECRET",
    "LINKEDIN_REDIRECT_URI",
    "LINKEDIN_API_VERSION",
    "NEWSLETTER_SUMMARY_AGENT_NAME",
    "NEWSLETTER_SUMMARY_AGENT_TIER",
    "CONTENT_GENERATOR_AGENT_NAME",
    "CONTENT_GENERATOR_AGENT_TIER",
    "CLIENT_RELEVANCE_AGENT_NAME",
    "CLIENT_RELEVANCE_AGENT_TIER"
  ],
  "busiboxAppVersion": "^3.0.0"
}
