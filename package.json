{
  "name": "newsletter-digest",
  "version": "1.0.0",
  "private": true,
  "description": "Busibox app for AI-powered Microsoft 365 newsletter summaries",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "sh -c 'next start -p ${PORT:-3002}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "next lint",
    "dev:busibox": "tsx dev-server/index.ts",
    "dev:busibox:init": "tsx dev-server/index.ts init",
    "update:busibox-app": "./scripts/update-busibox-app.sh",
    "link:busibox": "./scripts/link-local-busibox.sh",
    "unlink:busibox": "./scripts/unlink-local-busibox.sh"
  },
  "dependencies": {
    "@jazzmind/busibox-app": "^3.0.37",
    "jose": "^6.1.2",
    "lucide-react": "^0.469.0",
    "next": "^16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "express": "^5.1.0",
    "http-proxy-middleware": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "eslint": "^8",
    "eslint-config-next": "^15",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
